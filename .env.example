# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://private_chat_user:replace-with-local-password@localhost:5432/private_chat?schema=public
SHADOW_DATABASE_URL=postgresql://private_chat_user:replace-with-local-password@localhost:5432/private_chat_shadow?schema=public

# Secrets - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=replace-with-32-plus-random-bytes
PHONE_ENCRYPTION_KEY=replace-with-32-byte-base64-key
MESSAGE_ENCRYPTION_KEY=replace-with-another-32-byte-base64-key
LOOKUP_HMAC_SECRET=replace-with-32-plus-random-bytes
INVITE_HMAC_SECRET=replace-with-32-plus-random-bytes
CSRF_SECRET=replace-with-32-plus-random-bytes
IP_HASH_SECRET=replace-with-32-plus-random-bytes

# Invitation policy
INVITATION_TTL_HOURS=24
INVITATION_RATE_LIMIT_PER_HOUR=5
INVITATION_RESEND_COOLDOWN_SECONDS=60

# SMS provider - console provider is safe for local development only
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# Realtime
REALTIME_PORT=4001
REALTIME_ORIGIN=http://localhost:3000
NEXT_PUBLIC_REALTIME_URL=http://localhost:4001

# Set the trusted proxy hop count in production only after configuring your edge proxy
# to normalize X-Forwarded-For. Wrong values make IP-based limits inaccurate.
# TRUSTED_PROXY_HOPS=2
